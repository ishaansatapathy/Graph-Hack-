# API
PORT=8000
API_INTERNAL_URL=http://localhost:8000
# Public URL for GitHub webhooks (use ngrok in dev if needed)
API_PUBLIC_URL=http://localhost:8000
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Auth (generate a long random string for production)
JWT_SECRET=dev-only-change-this-secret-key
JWT_REFRESH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api-auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api-auth/google/callback

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=stackfox

# SQLite users DB (optional)
# DATABASE_PATH=./data/graph-hack.sqlite

OPENAI_API_KEY=
