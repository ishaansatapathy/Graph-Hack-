# ── Server ───────────────────────────────────────────────────
PORT=8000
API_INTERNAL_URL=http://localhost:8000
# Public URL for GitHub webhooks (use ngrok in dev)
API_PUBLIC_URL=http://localhost:8000
CLIENT_URL=http://localhost:3000
NODE_ENV=development
DEV_LOGIN_ENABLED=true
LOG_LEVEL=debug

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=dev-only-change-this-secret-key
JWT_REFRESH_SECRET=

# ── Google OAuth ──────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api-auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api-auth/google/callback

# ── PostgreSQL (Neon) ─────────────────────────────────────────
# Get from: https://console.neon.tech → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── FalkorDB ──────────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Leave empty in dev, set in prod
FALKORDB_PASSWORD=

# ── AI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=

# ── Email (Resend) ────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_...
# Dev: onboarding@resend.dev (sends only to your own email)
# Prod: verified domain, e.g. Stackfox <noreply@stackfox.com>
EMAIL_FROM=Stackfox <onboarding@resend.dev>

# ── Security ──────────────────────────────────────────────────
# Salt for device fingerprint hashing (generate: openssl rand -hex 32)
FP_SALT=stackfox-fp-v1-change-in-production
# Required in production; keep stable because it encrypts integration credentials.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── GitHub import (optional; raises the API rate limit, needed for private repos)
GITHUB_TOKEN=
