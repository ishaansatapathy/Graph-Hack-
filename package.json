{
  "name": "graph-hack",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @stackfox/api\" \"npm run dev -w @stackfox/web\"",
    "dev:api": "npm run dev -w @stackfox/api",
    "dev:web": "npm run dev -w @stackfox/web",
    "check-types": "npm run check-types -w @stackfox/services && npm run check-types -w @stackfox/trpc && npm run check-types -w @stackfox/api && npm run check-types -w @stackfox/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "dotenv -e .env -- npx drizzle-kit push",
    "db:generate": "dotenv -e .env -- npx drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- npx drizzle-kit migrate",
    "db:studio": "dotenv -e .env -- npx drizzle-kit studio"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.9.3"
  }
}
